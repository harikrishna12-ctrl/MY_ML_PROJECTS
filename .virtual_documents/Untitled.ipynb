import numpy as np


class LogisticRegression:

    def __init__(self,learning_rate =0.1,iters =1000):
        self.bias =None
        self.weights =None
        self.lr =learning_rate
        self.num_iter =iters
        
    def _sigmoid(self ,z):
        return (1/(1 + np.exp(-z)))
        
    def fit(self,X,y):
        m,n =X.shape
        self.bias =0
        self.weights =np.zeros(n)

        for i in range(self.num_iter):
            z = self.bias + np.dot(X ,self.weights)
            y_pred =self._sigmoid(z)

            db = (1/m) *(y_pred -y))
            dw = (1/m) *(np.dot(X.T, y_pred  - y))

            self.bias -= lr *db
            self.weights -=lr *dw

    def get_probabilities(self , X):
         z = self.bias + np.dot(X,self.weights)
         return self._sigmoid(z)


    def predict(self, X, threshold =0.5):
        probalities =self.get_probabilities(X)
        y_pred_bool = probalities>=threshold
        return y_pred_bool.astype(int)
            



