import numpy as np


#linear regresiion

class Linearregression:
    def __init__(self,learning_rate=0.1,max_iter =1000):
        self.bias =None
        self.weights = None
        self.lr = learning_rate
        self.iter =max_iter
    def fit(self,X,y):
       m,n = X.shape
       self.bias =0
       self.weights =np.zeros(n)
       for i in range(self.iter):
         y_pred =self.bias +np.dot(X,weights)

         db =(1/m) * np.sum(y_pred -y)
         dw = (1/m) * np.dot(X.T,(y_pred -y))


    def predict(self,X):
        y_pred =self.bias +np.dot(X,weights)
        return y_pred


x =np.array([[1],[2],[3]])
y =np.array([2,4,6])
model =Linearregression()
model.fit(x,y)

y_pred =model.predict(x)
print(y_pred)



