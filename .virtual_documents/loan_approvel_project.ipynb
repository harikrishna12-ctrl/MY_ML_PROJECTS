import numpy as np 
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


df = pd.read_csv("loan_approval_data.csv")
df

df2 = df.copy()
df2


#here we 50 null values for each row
df.isnull().sum()



df =df.dropna(axis =0)


df.isnull().sum()
df.info()

#see i made i mistake by dropping all the row which have null values thats why i have used copy option earlier we should use copy option


df2.info()





# we have numrical mising values and  catogorical missing values 
object_cols =df2.select_dtypes(include="object")
object_cols

numerical_cols =df2.select_dtypes(include ="number")
numerical_cols

for cols in numerical_cols:
    df2[cols] = df2[cols].fillna(df2[cols].mean())


for cols in object_cols:
    df2[cols] = df2[cols].fillna(df2[cols].mode()[0])

df2.isnull().sum()


#see i have cleared all the missing values ok 


df2


#see we have application id thats notrequired  ok now we drop the items or the rows thats not required 

df2 =df2.drop("Applicant_ID",axis =1)





classes_count = df2["Loan_Approved"].value_counts()
print(classes_count)
plt.pie(classes_count,labels=["No","Yes"],autopct="%1.1f%%")
plt.title("is loan is approved or not")


